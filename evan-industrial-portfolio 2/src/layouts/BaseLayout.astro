---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { site, copy } from '../data/site.js';
const { lang = 'zh', title = '', description = '', currentPath = '', showFooter = true } = Astro.props;
const isEn = lang === 'en';
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role[lang]}`;
const pageDescription = description || site.intro[lang];
const publicSiteUrl = import.meta.env.PUBLIC_SITE_URL || site.siteUrl;
const canonical = publicSiteUrl ? new URL(Astro.url.pathname, publicSiteUrl).toString() : undefined;
const ogLocale = isEn ? 'en_US' : 'zh_CN';
---
<!doctype html>
<html lang={isEn ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f7f7f3" />
    <meta name="color-scheme" content="light" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={ogLocale} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter fallback="swap" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"><span></span></div>
    <a class="skip-link" href="#main-content">{isEn ? 'Skip to content' : '跳到主要内容'}</a>
    <Header lang={lang} currentPath={currentPath} />
    <main id="main-content"><slot /></main>
    {showFooter && <Footer lang={lang} />}
    <button class="back-top-floating" type="button" aria-label={isEn ? 'Back to top' : '返回顶部'} data-back-top>↑</button>
    <script src="../scripts/interactions.js"></script>
  </body>
</html>
